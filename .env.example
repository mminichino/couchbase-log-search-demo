# Copy to .env and fill in locally. Never commit .env (gitignored).
# make loads .env automatically when present.

# Required for make cluster / destroy
TF_DIR=/path/to/couchbase-terraform/gcp/.../demo
CLUSTER_NAME=your-gke-cluster

# Optional — defaults shown
# PROJECT=          # defaults to: gcloud config get-value project
# REGION=us-central1
# NAMESPACE=logdemo
# REGISTRY=         # defaults to: $(REGION)-docker.pkg.dev/$(PROJECT)/logdemo
# SKIP_TF=1
# HELM_TIMEOUT=15m
# PLATFORM=linux/amd64

# Public Ingress hostnames (required for Discover/Grafana/Couchbase UI Ingress on make up)
DISCOVER_HOST=discover.example.com
GRAFANA_HOST=logdemo-grafana.example.com
COUCHBASE_UI_HOST=logdemo-cb.example.com

